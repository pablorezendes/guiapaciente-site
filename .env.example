# =============================================
# Guia do Paciente HSFA - variaveis de ambiente
# Copie este arquivo para .env e ajuste os valores
# =============================================

# --- Deploy (deploy.sh) ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=pablorezendes/guiapaciente-site
DEPLOY_BRANCH=main

# --- Servidor Express ---
PORT=3010
HOST=0.0.0.0
NODE_ENV=production

# --- Ouvidoria (opcional) ---
OUVIDORIA_MAIL_TO=ouvidoria@hsfasaude.com.br
OUVIDORIA_WEBHOOK_URL=

# --- Admin (upload de imagens) ---
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_HOURS=24
